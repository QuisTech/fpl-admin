{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/decision-logs",
      "destination": "/api/decision-logs"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "data/**"
    },
    "api/decision-logs.ts": {
      "maxDuration": 15
  },
  "crons": [
    {
      "path": "/api/cron-beta-expiry",
      "schedule": "0 0 * * *"
    }
  ]
}
