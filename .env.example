# Groq AI — Multi-key fallback (system dynamically cycles through all available keys and model tiers)
GROQ_API_KEY=gsk_...             # Primary key (required) or comma-separated list (e.g. gsk_1,gsk_2,gsk_3)
GROQ_API_KEY_2=gsk_...           # Backup key 2 (optional)
GROQ_API_KEY_3=gsk_...           # Backup key 3 (optional)
GROQ_API_KEY_4=gsk_...           # Backup key 4 (optional)
GROQ_API_KEY_5=gsk_...           # Backup key 5 (optional)

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=fpl-gemini-agent

# App URL
APP_URL=http://localhost:3000

